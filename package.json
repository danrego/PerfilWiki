{
  "name": "perfilwiki",
  "version": "1.20.1",
  "private": true,
  "description": "Estatísticas e atividade pública para páginas de usuário da Wikipédia em português.",
  "license": "CC-BY-SA-4.0",
  "author": "Daniel G Rego",
  "scripts": {
    "build": "node scripts/build-all.cjs",
    "test": "node --test tests/*.test.cjs tests/inherited_metrics.cjs installer/tests/*.test.mjs",
    "check:public": "python3 scripts/build.py --check-public",
    "verify:reproducible": "node scripts/verify-reproducible.cjs",
    "export:public": "python3 scripts/export_public.py"
  },
  "engines": {
    "node": "24.19.x",
    "pnpm": "11.25.0",
    "python": ">=3.9"
  },
  "packageManager": "pnpm@11.25.0"
}
